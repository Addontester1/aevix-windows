<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Aevix_App.Pages.LiveTvPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:m="using:Aevix.Core.Models"
    mc:Ignorable="d">
    <Grid Padding="24" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Categories sidebar -->
        <Border Background="{ThemeResource AevixCardBrush}" CornerRadius="{StaticResource AevixCardCornerRadius}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Categories" Style="{StaticResource SubtitleTextBlockStyle}" Padding="16,12,16,8" />
                <ListView x:Name="CategoryList" Grid.Row="1" SelectionMode="Single" SelectionChanged="CategoryList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="m:CategoryCount">
                            <Grid Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Group}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Count}" Opacity="0.55" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="Live TV" Style="{StaticResource TitleLargeTextBlockStyle}" />
                <TextBlock x:Name="StatusText" Foreground="{ThemeResource AevixMutedTextBrush}" />
            </StackPanel>

            <Grid Grid.Row="1" x:Name="EmptyState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE7F4;" FontSize="48" Foreground="{ThemeResource AevixMutedTextBrush}" />
                    <TextBlock Text="Pick a category on the left" Foreground="{ThemeResource AevixMutedTextBrush}" />
                </StackPanel>
            </Grid>

            <ListView x:Name="ChannelList" Grid.Row="1" DoubleTapped="ChannelList_DoubleTapped" SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="m:Channel">
                        <Grid Padding="8,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="6" Background="{ThemeResource AevixCardBrush}">
                                <Image Source="{x:Bind LogoUrl, Converter={StaticResource SafeImageSource}}" Stretch="Uniform" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Group}" FontSize="11" Foreground="{ThemeResource AevixMutedTextBrush}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE768;" FontSize="14" Foreground="{ThemeResource AevixMutedTextBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
