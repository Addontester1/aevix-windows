<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Aevix_App.Pages.MoviesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:m="using:Aevix.Core.Models"
    mc:Ignorable="d">
    <Grid Padding="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ListView x:Name="CategoryList" SelectionChanged="CategoryList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:CategoryCount">
                    <Grid Padding="8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Group}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Count}" Opacity="0.6" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Grid Grid.Column="1" Margin="16,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="StatusText" Style="{StaticResource SubtitleTextBlockStyle}" />
            <GridView x:Name="MovieGrid" Grid.Row="1" DoubleTapped="MovieGrid_DoubleTapped">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="m:VodItem">
                        <Grid Width="160" Height="240" Padding="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Image Source="{x:Bind PosterUrl}" Stretch="UniformToFill" />
                            <TextBlock Grid.Row="1" Text="{x:Bind Title}" TextWrapping="Wrap" MaxLines="2" />
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
    </Grid>
</Page>
