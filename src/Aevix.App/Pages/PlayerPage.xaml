<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Aevix_App.Pages.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d">
    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!--
            libVLC renders directly into a child HWND we host here. The
            SwapChainPanel itself is just a layout placeholder so the
            controls bar sits under the video area.
        -->
        <SwapChainPanel x:Name="VideoHost" />

        <Border Grid.Row="1" Background="{ThemeResource SystemControlBackgroundAcrylicElementBrush}" Padding="12">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold" />
                <Button Content="Play"  Click="Play_Click" />
                <Button Content="Pause" Click="Pause_Click" />
                <Button Content="Stop"  Click="Stop_Click" />
                <TextBlock x:Name="StatusText" Foreground="White" VerticalAlignment="Center" Opacity="0.7" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
