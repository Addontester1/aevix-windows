<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Aevix_App.Pages.PlaylistFormPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="12" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="Add playlist" Style="{StaticResource TitleTextBlockStyle}" />
            <ComboBox x:Name="TypeBox" Header="Type" SelectedIndex="0">
                <ComboBoxItem Content="M3U URL" Tag="M3UUrl" />
                <ComboBoxItem Content="M3U file" Tag="M3UFile" />
                <ComboBoxItem Content="Xtream Codes" Tag="Xtream" />
                <ComboBoxItem Content="Stalker portal" Tag="Stalker" />
            </ComboBox>
            <TextBox x:Name="NameBox" Header="Name" />
            <TextBox x:Name="UrlBox" Header="URL or file path" />
            <TextBox x:Name="UserBox" Header="Username (Xtream)" />
            <PasswordBox x:Name="PassBox" Header="Password (Xtream)" />
            <TextBox x:Name="MacBox" Header="MAC address (Stalker, e.g. 00:1A:79:AA:BB:CC)" />

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                <Button Content="Save" Click="Save_Click" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="Cancel" Click="Cancel_Click" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Opacity="0.7" />
        </StackPanel>
    </ScrollViewer>
</Page>
