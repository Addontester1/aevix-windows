<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Aevix_App.Pages.SeriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:m="using:Aevix.Core.Models"
    mc:Ignorable="d">
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="2">
            <TextBlock Text="Series" Style="{StaticResource TitleLargeTextBlockStyle}" />
            <TextBlock x:Name="StatusText" Foreground="{ThemeResource AevixMutedTextBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" x:Name="EmptyState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE8FE;" FontSize="48" Foreground="{ThemeResource AevixMutedTextBrush}" />
                <TextBlock Text="No series in this playlist." Foreground="{ThemeResource AevixMutedTextBrush}" />
            </StackPanel>
        </Grid>

        <GridView x:Name="SeriesGrid" Grid.Row="1" SelectionMode="Single">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="m:Series">
                    <Border Width="170" Height="280" Margin="4" CornerRadius="{StaticResource AevixPosterCornerRadius}"
                            Background="{ThemeResource AevixCardBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Image Source="{x:Bind PosterUrl}" Stretch="UniformToFill" />
                            <StackPanel Grid.Row="1" Padding="8,6" Spacing="2">
                                <TextBlock Text="{x:Bind Title}" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="12" />
                                <TextBlock Text="{x:Bind Genre}" FontSize="10" Foreground="{ThemeResource AevixMutedTextBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
